+
+// La ventana ya llena la pantalla (pantalla completa del sistema, o abierta así por un script): cuenta como pantalla
+// completa y no se muestra el botón.
+function fills() {
+  return innerWidth >= screen.width - 1 && innerHeight >= screen.height - 1;
+}
+function hintForFilled() {
