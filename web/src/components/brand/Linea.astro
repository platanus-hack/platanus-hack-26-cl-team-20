---
interface Props {
  size?: number;
  color?: string;
  class?: string;
}

const { size = 32, color = "currentColor", class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  aria-hidden="true"
  class:list={[className]}
>
  <!-- Tres barras horizontales 14×1.5, centradas en x=16 -->
  <rect x="9" y="11.25" width="14" height="1.5" fill={color} />
  <rect x="9" y="15.25" width="14" height="1.5" fill={color} />
  <rect x="9" y="19.25" width="14" height="1.5" fill={color} />
</svg>
