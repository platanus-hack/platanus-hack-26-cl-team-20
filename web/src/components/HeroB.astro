---
import { CIFRAS } from "../data/site";

/*
  Constelación de formas canónicas WUI sobre fondo Tinta.
  16 formas en 4 columnas × 4 filas con desplazamiento irregular.
  Tipos: Punto, Línea, Arco, Contorno — 4 de cada uno.
  Rotación leve (hasta 15°), escala (0.8 – 1.1×), halos en 3 formas.
*/

type TipoForma = "punto" | "linea" | "arco" | "contorno";

interface Forma {
  tipo: TipoForma;
  cx: number;   // posición X en el SVG (0–400)
  cy: number;   // posición Y
  rot: number;  // grados de rotación
  esc: number;  // escala
  halo: boolean;
  dir: number;  // dirección: 0=arriba 1=derecha 2=abajo 3=izquierda
}

// Cuadrícula base 4×4, celdas de ~88×65px sobre viewBox 400×280
// Desplazamientos irregulares para romper la uniformidad.
const BASE_X = [70, 160, 250, 340];
const BASE_Y = [52, 112, 172, 232];
const DX     = [0,  12, -8,  5,   -14,  7,  3, -10,   8, -5, 11,  -3,   -6,  4, -9,  7];
const DY     = [0,  -8,  5, 12,     3, -6, 10,  -4,  -9,  8, -3,  11,    6, -11, 4,  -7];
const ROT    = [0,   7, -4,  11,   -9,  3,  13,  -6,   5, -12, 8,   -2,  14, -7,  2, -11];
const ESC    = [1.0, 0.9, 1.1, 0.85, 1.05, 0.8, 1.0, 1.1, 0.95, 1.05, 0.85, 1.0, 1.1, 0.9, 1.0, 0.95];
// dir para arcos y contornos
const DIR    = [0, 1, 2, 3, 2, 0, 3, 1, 1, 3, 0, 2, 3, 1, 2, 0];

// Tipos en un patrón intercalado para distribuir los 4 tipos uniformemente
const TIPO_SEQ: TipoForma[] = ["punto","linea","arco","contorno","linea","arco","contorno","punto","arco","contorno","punto","linea","contorno","punto","linea","arco"];
// Halos en índices 2, 7, 11, 14
const HALO_IDX = new Set([2, 7, 11, 14]);

const formas: Forma[] = Array.from({ length: 16 }, (_, i) => ({
  tipo: TIPO_SEQ[i],
  cx: BASE_X[i % 4] + DX[i],
  cy: BASE_Y[Math.floor(i / 4)] + DY[i],
  rot: ROT[i],
  esc: ESC[i],
  halo: HALO_IDX.has(i),
  dir: DIR[i],
}));

// SVG paths para cada tipo de forma, en viewBox local 32×32 centrado en 16,16.
// Punt: círculo central r=4 + 4 satélites r=1.2 en cardinals
// Línea: 3 barras horizontales 12×1 con 3px de separación
// Arco: media luna según dir
// Contorno: bracket 12×12 grosor 1.5, abertura en dir

function puntoCentral() {
  return `<circle cx="16" cy="16" r="4" /><circle cx="16" cy="8" r="1.2" /><circle cx="24" cy="16" r="1.2" /><circle cx="16" cy="24" r="1.2" /><circle cx="8" cy="16" r="1.2" />`;
}

function lineaH() {
  return `<rect x="10" y="12" width="12" height="1" /><rect x="10" y="15.5" width="12" height="1" /><rect x="10" y="19" width="12" height="1" />`;
}

// Arco como path de media luna. dir: 0=abre arriba 1=derecha 2=abajo 3=izquierda
function arco(dir: number) {
  const rExt = 7, rInt = 4.5, cx = 16, cy = 16;
  // La luna creciente: diferencia entre dos círculos concéntricos pero el centro del pequeño desplazado
  // Usamos clipPath o simplemente dos arcos (anillo parcial 180°).
  // Semi-luna: anillo de 180° en la dirección dada.
  // start/end angles para cada dir (en radianes): 0=top(open up)→arco abajo visualmente
  const angles: [number, number][] = [
    [Math.PI, 2 * Math.PI],      // 0: abre arriba (arco visible abajo)
    [Math.PI * 1.5, Math.PI * 2.5], // 1: abre derecha
    [0, Math.PI],                // 2: abre abajo (arco visible arriba)
    [Math.PI * 0.5, Math.PI * 1.5], // 3: abre izquierda
  ];
  const [a0, a1] = angles[dir % 4];
  const steps = 24;
  // Outer arc a0→a1, inner arc a1→a0
  const pts = (r: number, from: number, to: number) =>
    Array.from({ length: steps + 1 }, (_, k) => {
      const a = from + ((to - from) * k) / steps;
      return [cx + Math.cos(a) * r, cy + Math.sin(a) * r];
    });
  const outer = pts(rExt, a0, a1);
  const inner = pts(rInt, a1, a0);
  const outerD = outer.map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(2)},${p[1].toFixed(2)}`).join(" ");
  const innerD = inner.map((p, i) => `${i === 0 ? "L" : "L"}${p[0].toFixed(2)},${p[1].toFixed(2)}`).join(" ");
  return `<path d="${outerD} ${innerD} Z" />`;
}

// Bracket 12×12, grosor 1.5, abertura en dir
// dir 0=abre arriba: dibuja ⊓  (tres lados: izq, derecha, abajo)
// dir 1=abre derecha: dibuja ⊏  (tres lados: arriba, izq, abajo)
// dir 2=abre abajo: dibuja ⊔  (tres lados: izq, arriba, derecha)
// dir 3=abre izquierda: dibuja ⊐  (tres lados: arriba, derecha, abajo)
function contorno(dir: number) {
  const L = 10, t = 1.5, s = (32 - L) / 2; // s=11, L=10, end=s+L=21
  const x0 = s, y0 = s, x1 = s + L, y1 = s + L;
  // Dibujamos como path de 3 segmentos (omitiendo el lado de la abertura)
  // dir 0 = abertura arriba → dibujamos lado izq, fondo, lado derecho
  if (dir === 0) return `<path d="M${x0},${y0} L${x0},${y1} L${x1},${y1} L${x1},${y0}" fill="none" stroke-width="${t}" />`;
  // dir 1 = abertura derecha → dibujamos arriba, izq, abajo
  if (dir === 1) return `<path d="M${x1},${y0} L${x0},${y0} L${x0},${y1} L${x1},${y1}" fill="none" stroke-width="${t}" />`;
  // dir 2 = abertura abajo → dibujamos lado izq, techo, lado derecho
  if (dir === 2) return `<path d="M${x0},${y1} L${x0},${y0} L${x1},${y0} L${x1},${y1}" fill="none" stroke-width="${t}" />`;
  // dir 3 = abertura izquierda → dibujamos arriba, derecha, abajo
  return `<path d="M${x0},${y0} L${x1},${y0} L${x1},${y1} L${x0},${y1}" fill="none" stroke-width="${t}" />`;
}

function formaInner(f: Forma): string {
  switch (f.tipo) {
    case "punto": return puntoCentral();
    case "linea": return lineaH();
    case "arco": return arco(f.dir);
    case "contorno": return contorno(f.dir);
  }
}

// Radio del halo (2× la escala visual de la forma, aprox 14px en coordenadas locales)
const HALO_R = 14;
---

<section class="hero-b relative isolate min-h-[100svh] overflow-hidden" aria-labelledby="titulo-b">
  <!-- Fondo: Tinta pura -->
  <div class="fondo-tinta absolute inset-0" aria-hidden="true"></div>
  <div class="velo-b pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid min-h-[100svh] max-w-[1440px] items-end gap-12 px-5 pb-12 pt-28 sm:px-8 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:pb-16">
    <div>
      <h1 id="titulo-b" class="display text-[clamp(2.6rem,6.2vw,6rem)]">Calibra la superficie en 4,4 segundos.</h1>
      <p class="mt-6 max-w-[46ch] text-luz-2 md:text-lg md:leading-snug">
        El proyector dibuja franjas de gray code y la cámara las lee. WUI calcula dónde cae cada píxel y tu agente proyecta sobre los objetos con un error de medio milímetro.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/#instalar" class="btn-luz"><span class="marca" aria-hidden="true"></span><span data-os-cta>Instalar</span></a>
        <a href="/#como" class="link-suave">Cómo funciona</a>
      </div>
    </div>

    <figure class="panel relative border border-linea bg-mesa/80 p-5 backdrop-blur-[2px] sm:p-6" aria-label="Constelación de formas canónicas WUI — telemetría de calibración">
      <!-- Constelación SVG -->
      <svg
        class="constelacion w-full"
        viewBox="0 0 400 280"
        aria-hidden="true"
        fill="none"
      >
        <!-- Fondo del lienzo: Tinta -->
        <rect x="0" y="0" width="400" height="280" fill="#171717" />
        <!-- Borde sutil -->
        <rect x="0.5" y="0.5" width="399" height="279" fill="none" stroke="var(--color-linea)" stroke-width="0.5" />

        {formas.map((f, i) => (
          /* Outer g: posición fija (translate + rotate + scale). No animada. */
          <g transform={`translate(${f.cx},${f.cy}) rotate(${f.rot}) scale(${f.esc})`}>
            {/* Inner g: solo opacity — es lo que animamos con CSS stagger. */}
            <g class={`forma forma-${i}`} style={`--i:${i}`}>
              {/* Halo tenue de detección */}
              {f.halo && (
                <circle
                  class="halo-det"
                  cx="0"
                  cy="0"
                  r={HALO_R}
                  fill="none"
                  stroke="var(--color-luz)"
                  stroke-width="1"
                  opacity="0.15"
                />
              )}
              {/* Forma canónica, coordenadas locales centradas en 0,0 */}
              <g
                fill={f.tipo === "punto" ? "var(--color-luz)" : "none"}
                stroke={f.tipo !== "punto" ? "var(--color-luz)" : "none"}
                stroke-width={f.tipo === "arco" ? "0" : "1"}
                set:html={formaInner(f)}
              />
            </g>
          </g>
        ))}
      </svg>

      <!-- Telemetría de calibración -->
      <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
        <div>
          <dt class="text-xs text-luz-3">Error</dt>
          <dd class="num mt-1 text-base"><span data-err>0,21</span> mm</dd>
        </div>
        <div>
          <dt class="text-xs text-luz-3">Patrón</dt>
          <dd class="num mt-1 text-base"><span data-bit>col 10/10</span></dd>
        </div>
        <div>
          <dt class="text-xs text-luz-3">Proyector</dt>
          <dd class="num mt-1 text-base"><span data-fps-b>{CIFRAS.fps},0</span> fps</dd>
        </div>
        <div>
          <dt class="text-xs text-luz-3">Punta a punta</dt>
          <dd class="num mt-1 text-base"><span data-lat-b>{CIFRAS.latencia}</span> ms</dd>
        </div>
      </dl>
      <canvas data-spark width="720" height="80" class="mt-4 h-10 w-full" aria-hidden="true"></canvas>
      <figcaption class="mt-3 text-xs text-luz-3">
        Latencia medida en el montaje real con PCX: {CIFRAS.latencia} ms (antes {CIFRAS.latenciaAntes} ms). Error de calibración simulado.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* Fondo Tinta canónico */
  .fondo-tinta {
    background: #171717;
  }

  /* Velo de borde: degrada la escena hacia los bordes de la sección */
  .velo-b {
    background:
      radial-gradient(120% 90% at 20% 80%, color-mix(in srgb, var(--color-mesa) 92%, transparent) 0%, color-mix(in srgb, var(--color-mesa) 50%, transparent) 45%, transparent 75%),
      linear-gradient(to top, var(--color-mesa), transparent 30%);
  }

  /* Stagger de entrada — opacity 0→1 con escala desde el wrapper SVG interno */
  @media (prefers-reduced-motion: no-preference) {
    .forma {
      opacity: 0;
      animation: forma-entra var(--dur-entra, 0.42s) var(--ease-tinta, cubic-bezier(0.16,1,0.3,1)) forwards;
      animation-delay: calc(var(--dur-entra, 0.42s) * 0.08 * var(--i, 0));
    }

    @keyframes forma-entra {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
  }

  /* Con movimiento reducido: todas visibles inmediatamente */
  @media (prefers-reduced-motion: reduce) {
    .forma {
      opacity: 1;
    }
  }

  /* Halo pulsante en formas con detección — solo con movimiento permitido */
  @media (prefers-reduced-motion: no-preference) {
    .halo-det {
      animation: halo-pulsa 2.8s ease-in-out infinite;
    }

    @keyframes halo-pulsa {
      0%, 100% { opacity: 0.1; }
      50%       { opacity: 0.22; }
    }
  }
</style>

<script>
  import { bucleVisible, inactivo, token } from "../scripts/suave";

  const spark   = document.querySelector<HTMLCanvasElement>("[data-spark]");
  const fpsEl   = document.querySelector("[data-fps-b]");
  const latEl   = document.querySelector("[data-lat-b]");

  // --- Sparkline de latencia (sin el bucle de grilla de calibración, reemplazado por SVG estático)
  if (spark) {
    const ctx = spark.getContext("2d")!;
    const hist: number[] = Array.from({ length: 90 }, () => 215 + (Math.random() - 0.5) * 10);
    let lat = 215;
    setInterval(() => {
      if (inactivo()) return;
      lat += (215 + (Math.random() - 0.5) * 16 - lat) * 0.45;
      hist.push(lat);
      hist.shift();
      const W = spark.width, H = spark.height;
      ctx.clearRect(0, 0, W, H);
      // Línea de referencia (latencia anterior: 313 ms)
      ctx.strokeStyle = token("linea");
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, H - ((313 - 180) / 150) * H);
      ctx.lineTo(W, H - ((313 - 180) / 150) * H);
      ctx.stroke();
      // Curva activa
      ctx.strokeStyle = token("luz");
      ctx.lineWidth = 2;
      ctx.beginPath();
      hist.forEach((v, i) => {
        const x = (i / (hist.length - 1)) * W;
        const y = H - ((v - 180) / 150) * H;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      });
      ctx.stroke();
      if (latEl) latEl.textContent = String(Math.round(lat));
      if (fpsEl) fpsEl.textContent = (60 - (Math.random() < 0.2 ? Math.random() * 0.3 : 0)).toFixed(1).replace(".", ",");
    }, 140);
  }
</script>
