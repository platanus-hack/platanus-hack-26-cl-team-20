---
// Vista cenital de una mesa. Capa base: tablero, marcadores ArUco y objetos.
// Capa proyectada (otra SVG con el mismo viewBox): contornos, etiquetas y guías.
// El cursor es el haz del proyector; sin cursor, un piloto automático recorre los objetos.

const aruco = [
  // Bits internos 4x4 de cuatro marcadores (DICT_4X4), fila por fila.
  { x: 70, y: 70, bits: "1011010001101001" },
  { x: 1458, y: 70, bits: "0110110010010111" },
  { x: 70, y: 858, bits: "1100011110100010" },
  { x: 1458, y: 858, bits: "0101101011000110" },
];
const M = 72; // lado del marcador con borde negro
const c = M / 6;
---

<div data-mesa class="mesa absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="mesa-plano absolute inset-0">
    <svg class="mesa-base absolute inset-0 h-full w-full" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="mm" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#f1eee4" stroke-opacity="0.045" stroke-width="1" />
        </pattern>
        <pattern id="mm5" width="200" height="200" patternUnits="userSpaceOnUse">
          <path d="M200 0H0V200" fill="none" stroke="#f1eee4" stroke-opacity="0.07" stroke-width="1" />
        </pattern>
        <radialGradient id="haz">
          <stop offset="0" stop-color="#fff6e6" stop-opacity="0.2" />
          <stop offset="0.45" stop-color="#fff6e6" stop-opacity="0.07" />
          <stop offset="1" stop-color="#fff6e6" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="cuerpo" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#262922" />
          <stop offset="1" stop-color="#151712" />
        </linearGradient>
        <filter id="sombra" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="10" />
          <feOffset dx="10" dy="14" />
          <feComponentTransfer><feFuncA type="linear" slope="0.55" /></feComponentTransfer>
          <feMerge><feMergeNode /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>

      <rect width="1600" height="1000" fill="#0d0e0b" />
      <rect width="1600" height="1000" fill="url(#mm)" />
      <rect width="1600" height="1000" fill="url(#mm5)" />

      {
        aruco.map((m) => (
          <g transform={`translate(${m.x} ${m.y})`}>
            <rect x="-10" y="-10" width={M + 20} height={M + 20} fill="#d9d6cc" />
            <rect width={M} height={M} fill="#0b0c0a" />
            {m.bits.split("").map((b, i) =>
              b === "1" ? <rect x={c + (i % 4) * c} y={c + Math.floor(i / 4) * c} width={c} height={c} fill="#d9d6cc" /> : null,
            )}
          </g>
        ))
      }

      <circle id="luz" cx="1100" cy="420" r="300" fill="url(#haz)" />

      <g class="objetos" filter="url(#sombra)">
        <!-- libreta -->
        <g data-obj="libreta" data-x="1040" data-y="335">
          <g transform="translate(1040 335) rotate(-7)">
            <rect x="-150" y="-195" width="300" height="390" rx="6" fill="url(#cuerpo)" />
            <rect x="-150" y="-195" width="300" height="390" rx="6" fill="none" stroke="#3a3d35" />
            {Array.from({ length: 11 }, (_, i) => <circle cx="-132" cy={-170 + i * 34} r="5" fill="#0b0c0a" stroke="#4a4d44" />)}
            {Array.from({ length: 9 }, (_, i) => <line x1="-100" x2="125" y1={-120 + i * 36} y2={-120 + i * 36} stroke="#2e312a" />)}
          </g>
        </g>
        <!-- taza -->
        <g data-obj="taza" data-x="1405" data-y="245" data-deriva="1">
          <g class="cuerpo">
            <rect x="1462" y="231" width="46" height="28" rx="12" fill="#22251f" stroke="#3a3d35" />
            <circle cx="1405" cy="245" r="66" fill="url(#cuerpo)" stroke="#3a3d35" />
            <circle cx="1405" cy="245" r="52" fill="#1a1308" />
            <circle cx="1393" cy="233" r="16" fill="#f1eee4" fill-opacity="0.05" />
          </g>
        </g>
        <!-- maceta -->
        <g data-obj="maceta" data-x="760" data-y="255">
          <circle cx="760" cy="255" r="84" fill="#1d1f19" stroke="#3a3d35" />
          {
            [0, 52, 118, 170, 228, 290].map((a, i) => (
              <ellipse
                cx="760"
                cy={255 - 44 - (i % 2) * 10}
                rx="20"
                ry="48"
                fill={i % 2 ? "#2b3325" : "#242b20"}
                stroke="#3c4536"
                transform={`rotate(${a} 760 255)`}
              />
            ))
          }
          <circle cx="760" cy="255" r="12" fill="#323a2b" />
        </g>
        <!-- llaves -->
        <g data-obj="llaves" data-x="822" data-y="700">
          <circle cx="822" cy="700" r="24" fill="none" stroke="#4b4e45" stroke-width="6" />
          <g transform="rotate(28 822 700)">
            <rect x="842" y="692" width="78" height="16" rx="3" fill="#30332c" stroke="#4b4e45" />
            <path d="M884 708v8h6v-8m8 0v6h6v-6" fill="none" stroke="#4b4e45" stroke-width="3" />
          </g>
          <g transform="rotate(118 822 700)">
            <rect x="842" y="692" width="64" height="14" rx="3" fill="#2a2d26" stroke="#4b4e45" />
          </g>
        </g>
        <!-- celular -->
        <g data-obj="celular" data-x="1345" data-y="700">
          <g transform="translate(1345 700) rotate(14)">
            <rect x="-80" y="-160" width="160" height="320" rx="24" fill="#10110e" stroke="#3a3d35" stroke-width="2" />
            <rect x="-70" y="-148" width="140" height="296" rx="16" fill="#151a1c" />
            <rect x="-22" y="-142" width="44" height="10" rx="5" fill="#0b0c0a" />
          </g>
        </g>
      </g>

      <g class="toques"></g>
    </svg>

    <!-- Lo que proyecta el sistema: mismo sistema de coordenadas, se corrige con keystone. -->
    <div class="mesa-proy absolute inset-0">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
        <g class="graycode-mesa">
          <rect x="0" y="0" width="1600" height="1000" fill="url(#gc-patron)" />
        </g>
        <defs>
          <pattern id="gc-patron" class="gc-patron" width="128" height="1000" patternUnits="userSpaceOnUse">
            <rect width="64" height="1000" fill="#f1eee4" />
          </pattern>
        </defs>

        <!-- libreta: guía proyectada sobre la página -->
        <g class="ov" data-ov="libreta">
          <g transform="translate(1040 335) rotate(-7)">
            <rect class="contorno" x="-166" y="-211" width="332" height="422" rx="10" pathLength="1" />
            <g class="dentro">
              <text x="-96" y="-118" class="t-num" font-size="64">2/5</text>
              <text x="-96" y="-78" class="t-sm">Dobla por la línea</text>
              <line x1="-120" y1="40" x2="140" y2="-10" class="guia" />
              <path d="M96 -40 l44 30 -52 16" class="flecha" />
              <text x="-96" y="150" class="t-xs">project(guía, libreta)</text>
            </g>
          </g>
          <g class="etiqueta" transform="translate(960 572)">
            <line x1="20" y1="-34" x2="0" y2="0" class="lider" />
            <text x="8" y="30" class="t-lbl">libreta</text>
            <text x="8" y="56" class="t-xs">guía paso a paso</text>
          </g>
        </g>

        <!-- taza: temporizador alrededor -->
        <g class="ov" data-ov="taza">
          <g class="sigue">
            <circle class="contorno" cx="1405" cy="245" r="84" pathLength="1" />
            <circle class="anillo" cx="1405" cy="245" r="104" pathLength="1" transform="rotate(-90 1405 245)" />
            <text x="1405" y="392" text-anchor="middle" class="t-lbl">taza</text>
            <text x="1405" y="418" text-anchor="middle" class="t-xs">té listo en <tspan class="t-cuenta">3:40</tspan></text>
          </g>
        </g>

        <!-- maceta: domótica -->
        <g class="ov" data-ov="maceta">
          <circle class="contorno" cx="760" cy="255" r="102" pathLength="1" />
          <g class="etiqueta" transform="translate(890 180)">
            <line x1="-30" y1="40" x2="0" y2="0" class="lider" />
            <text x="10" y="4" class="t-lbl">maceta</text>
            <text x="10" y="30" class="t-xs">riego 07:00, vía domótica</text>
          </g>
        </g>

        <!-- llaves: memoria del espacio -->
        <g class="ov" data-ov="llaves">
          <rect class="contorno" x="772" y="650" width="152" height="112" rx="10" pathLength="1" transform="rotate(10 848 706)" />
          <g class="etiqueta" transform="translate(950 760)">
            <line x1="-26" y1="-24" x2="0" y2="0" class="lider" />
            <text x="10" y="18" class="t-lbl">llaves</text>
            <text x="10" y="44" class="t-xs">aquí desde las 08:12</text>
          </g>
        </g>

        <!-- celular: botones táctiles proyectados en la mesa -->
        <g class="ov" data-ov="celular">
          <g transform="translate(1345 700) rotate(14)">
            <rect class="contorno" x="-96" y="-176" width="192" height="352" rx="30" pathLength="1" />
          </g>
          <g class="botones" transform="translate(1110 610)">
            <rect class="boton boton-si" width="150" height="56" />
            <text x="22" y="36" class="t-btn">Contestar</text>
            <rect class="boton" y="72" width="150" height="56" />
            <text x="22" y="108" class="t-btn">Después</text>
          </g>
        </g>

        <!-- retícula que sigue al haz -->
        <g class="reticula">
          <circle r="18" />
          <path d="M-34 0h22M12 0h22M0 -34v22M0 12v22" />
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  .mesa {
    --kx: 0deg;
    --ky: 0deg;
  }
  .mesa-plano {
    transform: perspective(2200px) rotateX(var(--kx)) rotateY(var(--ky));
    transform-origin: 60% 50%;
    will-change: transform;
  }
  .mesa-proy {
    transform-origin: 62% 40%;
    transition: transform 900ms var(--ease-proyector), filter 600ms;
    pointer-events: none;
  }
  /* Proyector desalineado: keystone visible antes de recalibrar. */
  .mesa.desalineado .mesa-proy {
    transform: perspective(900px) rotateX(9deg) rotateZ(-1.4deg) scale(1.04, 0.97) translate(14px, -10px);
    transition-duration: 380ms;
    filter: drop-shadow(3px 0 0 rgba(255, 61, 46, 0.55)) drop-shadow(-3px 0 0 rgba(46, 201, 255, 0.55));
  }

  .mesa-proy :global(text) {
    fill: var(--color-luz);
  }
  .mesa-proy :global(.t-lbl) {
    font: 520 28px var(--font-sans);
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .mesa-proy :global(.t-sm) {
    font: 500 24px var(--font-sans);
  }
  .mesa-proy :global(.t-xs) {
    font: 400 17px var(--font-mono);
    fill: var(--color-luz-2) !important;
  }
  .mesa-proy :global(.t-num) {
    font-family: var(--font-sans);
    font-weight: 250;
    font-stretch: 120%;
  }
  .mesa-proy :global(.t-btn) {
    font: 560 22px var(--font-sans);
  }

  .ov {
    opacity: 0.16;
    transition: opacity 500ms var(--ease-proyector);
  }
  .ov.activo {
    opacity: 1;
  }
  .ov :global(.contorno) {
    fill: none;
    stroke: var(--color-luz);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0.82;
    transition: stroke-dashoffset 900ms var(--ease-proyector);
    filter: drop-shadow(1.5px 0 0 rgba(255, 61, 46, 0.5)) drop-shadow(-1.5px 0 0 rgba(46, 201, 255, 0.5));
  }
  .ov.activo :global(.contorno) {
    stroke-dashoffset: 0;
  }
  .ov :global(.dentro),
  .ov :global(.etiqueta),
  .ov :global(.botones),
  .ov :global(.anillo),
  .ov :global(text) {
    opacity: 0;
    transition: opacity 400ms 150ms;
  }
  .ov.activo :global(.dentro),
  .ov.activo :global(.etiqueta),
  .ov.activo :global(.botones),
  .ov.activo :global(.anillo),
  .ov.activo :global(text) {
    opacity: 1;
  }
  .ov :global(.lider) {
    stroke: var(--color-luz-2);
    stroke-width: 1.5;
  }
  .ov :global(.guia) {
    stroke: var(--color-luz);
    stroke-width: 2.5;
    stroke-dasharray: 10 8;
    animation: marcha 1.2s linear infinite;
  }
  .ov :global(.flecha) {
    fill: none;
    stroke: var(--color-luz);
    stroke-width: 3;
  }
  .ov :global(.anillo) {
    fill: none;
    stroke: var(--color-senal);
    stroke-width: 6;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--resto, 0.4);
  }
  .ov :global(.boton) {
    fill: none;
    stroke: var(--color-luz);
    stroke-width: 2;
  }
  .ov :global(.boton-si) {
    fill: var(--color-luz);
    fill-opacity: 0.12;
  }
  .ov :global(.boton.tocado) {
    fill: var(--color-senal);
    fill-opacity: 0.9;
    stroke: var(--color-senal);
  }

  .reticula {
    fill: none;
    stroke: var(--color-luz);
    stroke-opacity: 0.7;
    stroke-width: 1.5;
  }

  .graycode-mesa {
    opacity: 0;
    mix-blend-mode: normal;
  }
  .mesa.calibrando .graycode-mesa {
    opacity: 0.1;
  }
  .mesa :global(.toque) {
    fill: none;
    stroke: var(--color-senal);
    stroke-width: 3;
  }

  @keyframes marcha {
    to {
      stroke-dashoffset: -36;
    }
  }
</style>

<script>
  import { bucleVisible, reducido } from "../scripts/suave";

  const raiz = document.querySelector<HTMLElement>("[data-mesa]");
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const base = raiz.querySelector<SVGSVGElement>("svg.mesa-base")!;
    const proySvg = raiz.querySelector<SVGSVGElement>(".mesa-proy svg")!;
    const luz = raiz.querySelector<SVGCircleElement>("#luz")!;
    const reticula = raiz.querySelector<SVGGElement>(".reticula")!;
    const patron = raiz.querySelector<SVGPatternElement>(".gc-patron")!;
    const patronRect = patron.querySelector("rect")!;
    const toques = raiz.querySelector<SVGGElement>(".toques")!;
    const quieto = reducido();

    // Móvil vertical: encuadrar el lado derecho, donde están los objetos.
    const encuadre = () => {
      const par = raiz.clientWidth / Math.max(1, raiz.clientHeight) < 1.1 ? "xMaxYMid slice" : "xMidYMid slice";
      base.setAttribute("preserveAspectRatio", par);
      proySvg.setAttribute("preserveAspectRatio", par);
    };
    encuadre();
    new ResizeObserver(encuadre).observe(raiz);

    type Obj = { id: string; x: number; y: number; ov: SVGGElement; deriva: boolean; cuerpo: SVGGElement };
    const objs: Obj[] = [...raiz.querySelectorAll<SVGGElement>("[data-obj]")].map((el) => ({
      id: el.dataset.obj!,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      deriva: el.dataset.deriva === "1",
      cuerpo: el,
      ov: raiz.querySelector<SVGGElement>(`[data-ov="${el.dataset.obj}"]`)!,
    }));

    let lx = 1100, ly = 420, tx = lx, ty = ly;
    let ultimoPuntero = -1e9;
    let activo: Obj | null = null;
    let piloto = 0;

    const aSvg = (cx: number, cy: number) => {
      const m = base.getScreenCTM();
      if (!m) return { x: lx, y: ly };
      const p = new DOMPoint(cx, cy).matrixTransform(m.inverse());
      return { x: p.x, y: p.y };
    };

    const marco = raiz.closest<HTMLElement>("[data-mesa-host]") ?? raiz;
    marco.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch") return;
      const p = aSvg(e.clientX, e.clientY);
      tx = p.x;
      ty = p.y;
      ultimoPuntero = performance.now();
      const r = marco.getBoundingClientRect();
      raiz.style.setProperty("--ky", `${((e.clientX - r.left) / r.width - 0.5) * 3}deg`);
      raiz.style.setProperty("--kx", `${((e.clientY - r.top) / r.height - 0.5) * -2.4}deg`);
    });
    marco.addEventListener("pointerdown", (e) => {
      if ((e.target as Element).closest("a, button")) return;
      const p = aSvg(e.clientX, e.clientY);
      tx = p.x;
      ty = p.y;
      ultimoPuntero = performance.now();
      tocar(p.x, p.y);
    });

    const ns = "http://www.w3.org/2000/svg";
    function tocar(x: number, y: number) {
      const c = document.createElementNS(ns, "circle");
      c.setAttribute("cx", String(x));
      c.setAttribute("cy", String(y));
      c.setAttribute("r", "8");
      c.setAttribute("class", "toque");
      toques.appendChild(c);
      c.animate([{ r: 8, opacity: 1 } as any, { r: 70, opacity: 0 } as any], { duration: 700, easing: "cubic-bezier(.2,.7,.1,1)" }).finished.then(() => c.remove());
      if (Math.hypot(x - 1185, y - 666) < 120) {
        const b = raiz.querySelector(".boton-si");
        b?.classList.add("tocado");
        setTimeout(() => b?.classList.remove("tocado"), 900);
        emitir("touch celular → Contestar");
      } else {
        emitir(`touch (${Math.round(x)}, ${Math.round(y)})`);
      }
    }

    // Registro de eventos (lo que recibiría el agente por events_wait).
    const registro = document.querySelector<HTMLOListElement>("[data-registro]");
    function emitir(txt: string) {
      if (!registro) return;
      const li = document.createElement("li");
      li.textContent = txt;
      registro.prepend(li);
      while (registro.children.length > 4) registro.lastElementChild!.remove();
    }
    const eventos = [
      "scene → 5 objetos, 1 mano",
      "object_moved taza 14 mm",
      "events_wait → hand_enter",
      'history "llaves" → 08:12',
      "home luz_escritorio 40 %",
      "look → libreta, página 2",
    ];
    let ev = 1;
    if (!quieto) {
      setInterval(() => {
        if (!document.hidden) emitir(eventos[ev++ % eventos.length]);
      }, 2300);
    }

    // Telemetría creíble: 60 fps con jitter de décimas, 215 ms ± ruido.
    const fps = document.querySelector("[data-fps]");
    const lat = document.querySelector("[data-lat]");
    let latS = 215;
    if (!quieto) {
      setInterval(() => {
        if (document.hidden) return;
        const f = 60 - (Math.random() < 0.25 ? Math.random() * 0.3 : 0);
        latS += (215 + (Math.random() - 0.5) * 14 - latS) * 0.5;
        if (fps) fps.textContent = f.toFixed(1).replace(".", ",");
        if (lat) lat.textContent = String(Math.round(latS));
      }, 520);
    }

    // Ciclo de recalibración: el proyector se desalinea, barre gray code y vuelve a calzar.
    const anchos = [512, 256, 128, 64, 32, 16, 8];
    function recalibrar() {
      if (document.hidden) return;
      raiz.classList.add("desalineado");
      setTimeout(() => {
        raiz.classList.add("calibrando");
        let i = 0;
        const paso = setInterval(() => {
          const w = anchos[i % anchos.length];
          patron.setAttribute("width", String(w * 2));
          patronRect.setAttribute("width", String(w));
          if (++i >= anchos.length) {
            clearInterval(paso);
            raiz.classList.remove("calibrando", "desalineado");
            objs.forEach((o) => {
              if (o === activo) {
                o.ov.classList.remove("activo");
                requestAnimationFrame(() => o.ov.classList.add("activo"));
              }
            });
            emitir("calibrate → error 0,5 mm");
          }
        }, 170);
      }, 520);
    }
    if (!quieto) {
      setTimeout(recalibrar, 2600);
      setInterval(recalibrar, 13000);
    }

    // Temporizador de la taza.
    const cuenta = raiz.querySelector(".t-cuenta");
    const anillo = raiz.querySelector<SVGElement>(".anillo");
    let seg = 220;
    if (!quieto) {
      setInterval(() => {
        seg = seg <= 0 ? 240 : seg - 1;
        if (cuenta) cuenta.textContent = `${Math.floor(seg / 60)}:${String(seg % 60).padStart(2, "0")}`;
        anillo?.style.setProperty("--resto", String(1 - seg / 240));
      }, 1000);
    }

    const tazaOv = raiz.querySelector<SVGGElement>('[data-ov="taza"] .sigue');
    const taza = objs.find((o) => o.id === "taza")!;
    const tazaCuerpo = taza.cuerpo.querySelector<SVGGElement>(".cuerpo")!;

    function marcar(o: Obj | null) {
      if (o === activo) return;
      activo?.ov.classList.remove("activo");
      activo = o;
      o?.ov.classList.add("activo");
    }

    function paso(t: number, dt: number) {
      const ocioso = t - ultimoPuntero > 2600;
      if (ocioso) {
        // Piloto automático: visita objetos con un pequeño vagabundeo.
        piloto += dt;
        const o = objs[Math.floor(piloto / 2900) % objs.length];
        tx = o.x + Math.sin(t / 900) * 40 - 20;
        ty = o.y + Math.cos(t / 1100) * 30;
      }
      const k = 1 - Math.pow(ocioso ? 0.965 : 0.86, dt / 16);
      lx += (tx - lx) * k;
      ly += (ty - ly) * k;
      luz.setAttribute("cx", lx.toFixed(1));
      luz.setAttribute("cy", ly.toFixed(1));
      reticula.setAttribute("transform", `translate(${lx.toFixed(1)} ${ly.toFixed(1)})`);

      // La taza se desliza sola: el contorno la sigue.
      const dx = Math.sin(t / 2600) * 22, dy = Math.cos(t / 3400) * 12;
      taza.x = 1405 + dx;
      taza.y = 245 + dy;
      const tr = `translate(${dx.toFixed(1)} ${dy.toFixed(1)})`;
      tazaCuerpo.setAttribute("transform", tr);
      tazaOv?.setAttribute("transform", tr);

      let mejor: Obj | null = null, dmin = 240;
      for (const o of objs) {
        const d = Math.hypot(o.x - lx, o.y - ly);
        if (d < dmin) { dmin = d; mejor = o; }
      }
      marcar(mejor);
      if (ocioso) {
        raiz.style.setProperty("--ky", `${Math.sin(t / 4000) * 1.2}deg`);
        raiz.style.setProperty("--kx", `${Math.cos(t / 5000) * 0.8}deg`);
      }
    }

    if (quieto) {
      marcar(objs[0]);
      objs[1].ov.classList.add("activo");
      return;
    }
    bucleVisible(raiz, paso);
  }
</script>
