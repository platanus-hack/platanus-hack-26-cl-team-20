---
import { NOMBRE } from "../data/site";
interface Props { completa?: boolean }
const { completa = true } = Astro.props;
const base = completa ? "" : "/";
---

<header class="absolute inset-x-0 top-0 z-30">
  <nav aria-label="Principal" class="mx-auto flex max-w-[1440px] items-center justify-between px-5 py-5 sm:px-8">
    <a href="/" class="flex items-center gap-3 text-luz" aria-label={`${NOMBRE}, inicio`}>
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" fill="#f1eee4" /><rect x="4" y="4" width="24" height="24" fill="#0b0c0a" />
        <g fill="#f1eee4"><rect x="8" y="8" width="4" height="4" /><rect x="16" y="8" width="8" height="4" /><rect x="12" y="12" width="4" height="4" /><rect x="20" y="16" width="4" height="4" /><rect x="8" y="16" width="8" height="4" /><rect x="12" y="20" width="4" height="4" /><rect x="20" y="20" width="4" height="4" /></g>
      </svg>
      <span class="text-lg font-semibold tracking-tight" style="font-stretch:125%">{NOMBRE}</span>
    </a>
    <ul class="flex items-center gap-6 text-sm text-luz-2">
      <li class="hidden md:block"><a class="hover:text-luz" href={`${base}#como`}>Cómo funciona</a></li>
      <li class="hidden md:block"><a class="hover:text-luz" href={`${base}#agentes`}>Agentes</a></li>
      <li class="hidden md:block"><a class="hover:text-luz" href={`${base}#privacidad`}>Privacidad</a></li>
      <li><a class="border border-luz/30 px-3 py-1.5 text-luz hover:border-luz" href={`${base}#instalar`}>Instalar</a></li>
    </ul>
  </nav>
</header>
