---
import "../styles/global.css";
import { NOMBRE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  propuesta?: "a" | "b" | "c";
}
const {
  title = `${NOMBRE}: contexto físico para tu agente`,
  description = "Un proyector y una cámara entienden tu mesa. Claude Code, Codex u OpenCode la ven por MCP y proyectan interfaces sobre objetos reales.",
  propuesta,
} = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/martian-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-mesa text-luz">
    <a href="#contenido" class="sr-only-focusable fixed left-4 top-4 z-50 bg-luz px-4 py-2 text-mesa">Saltar al contenido</a>
    <slot />
    {
      propuesta && (
        <nav aria-label="Propuestas de hero" class="fixed bottom-4 left-4 z-40 flex items-center gap-1 bg-mesa/85 p-1 text-sm backdrop-blur-sm">
          {(["a", "b", "c"] as const).map((p) => (
            <a
              href={`/${p}`}
              aria-current={p === propuesta ? "page" : undefined}
              class:list={["num px-3 py-1.5 text-xs", p === propuesta ? "bg-luz text-mesa" : "text-luz-2 hover:text-luz"]}
            >
              {p.toUpperCase()}
            </a>
          ))}
          <a href="/" class="px-3 py-1.5 text-luz-2 hover:text-luz">Página completa</a>
        </nav>
      )
    }
    <script>
      import { iniciarScrollSuave } from "../scripts/suave";
      iniciarScrollSuave();
    </script>
  </body>
</html>
