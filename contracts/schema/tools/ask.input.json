          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "offset_mm": {
          "title": "PointMM",
          "description": "Punto en mm del marco `table_mm`. En el cable: `[x, y]` (exactamente 2 números).",
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "default": null
        }
      },
      "required": [],
      "default": null
    }
  },
  "required": [
    "request_id",
    "question",
    "options"
  ]
