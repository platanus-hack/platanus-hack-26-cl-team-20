{
  "description": "Proyecta una pregunta con un botón por opción; responde con el evento `ask_answered` o vence.",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1
    },
    "timeout_s": {
      "type": "number",
      "minimum": 1,
      "maximum": 600,
      "default": 60.0
    },
    "anchor": {
      "title": "Anchor",
      "description": "Dónde se ancla un widget: a un objeto (lo sigue si se mueve) o a un punto fijo, más un desplazamiento.",
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string"
        },
        "point_mm": {
          "title": "PointMM",
          "description": "Punto en mm del marco `table_mm`. En el cable: `[x, y]`.",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2
        },
        "offset_mm": {
          "title": "PointMM",
          "description": "Punto en mm del marco `table_mm`. En el cable: `[x, y]`.",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2
        }
      },
      "required": []
    }
  },
  "required": [
    "question",
    "options"
  ]
}
